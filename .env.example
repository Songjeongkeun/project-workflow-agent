# 서버 설정 (backend/config.py). 서버 환경 변수로 넣는다. 비우면 기본값을 쓴다.
# ORBIT_DB_PATH=        기본: 저장소의 data/orbit.db
# ORBIT_DATA_DIR=       기본: 저장소의 data/
ORBIT_TOKEN_HOURS=12
ORBIT_CORS_ORIGINS=http://localhost:5173
ORBIT_FIX_RETRY_LIMIT=5

# 에이전트를 붙일 때 쓰는 값 (팀원 에이전트가 읽는다. LLM 입력과 실행 기록에 넣지 않는다)
ANTHROPIC_API_KEY=
# A01 기획 에이전트: stub(임시) 또는 planning_agent(실제, OPENAI_API_KEY 필요)
ORBIT_A01_AGENT=stub
OPENAI_API_KEY=
OPENAI_MODEL=
GITHUB_TOKEN=
NOTION_TOKEN=
SLACK_BOT_TOKEN=
FIGMA_TOKEN=

# workspace 서버
# ORBIT_WORKSPACE_ROOT=  기본: 저장소의 data/workspaces/
ORBIT_WORKSPACE_PORT=8100
ORBIT_COMMAND_TIMEOUT=600
ORBIT_USE_CONTAINER=false

# Slack 알림. 토큰은 .env에만 넣고 git에 올리지 않는다
# true로 바꾸면 쌓인 알림을 실제로 보낸다
ORBIT_NOTIFY_ENABLED=false
ORBIT_APP_URL=http://localhost:5173
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
# Notion 게시. 위의 NOTION_TOKEN과 함께 게시용 상위 페이지 주소(또는 ID)를 넣는다
NOTION_PARENT_PAGE=
